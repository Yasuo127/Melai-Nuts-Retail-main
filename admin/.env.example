APP_NAME="Melai Nuts Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Melai Nuts admin -------------------------------------------------------
# First admin login (created by `php artisan migrate --seed`). CHANGE before deploying.
ADMIN_NAME="Melai Admin"
ADMIN_EMAIL=admin@melainuts.test
ADMIN_PASSWORD="ChangeMe#2026"
# Optional: Firebase UID of the owner's account in the app; the seeder links the admin to it.
ADMIN_STAFF_UID=

# Where business data comes from: supabase (the mobile app's real data) | mock (demo data, no database)
DATA_SOURCE=supabase

# The mobile app's Supabase Postgres. Supabase dashboard > Connect > "Session pooler".
# User is the melai_admin_portal role from supabase/migrations/20261009000000_admin_portal.sql
# (on the pooler the user name is melai_admin_portal.<project-ref>). NEVER use the postgres
# password or the service_role key here.
SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=postgres
SUPABASE_DB_USERNAME=melai_admin_portal.your-project-ref
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require
# Or one URL instead of the five lines above:
# SUPABASE_DB_URL=postgresql://melai_admin_portal.your-project-ref:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
SUPABASE_ORDER_WINDOW_DAYS=90
DEFAULT_DAILY_TARGET=5000

# PayMongo: only used with DATA_SOURCE=mock (the app's online payments go through HitPay).
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=sk_test_replace_me
PAYMONGO_WEBHOOK_SECRET=whsec_replace_me
